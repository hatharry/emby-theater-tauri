{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emby Theater",
  "version": "0.1.0",
  "identifier": "tv.emby.theater.tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Emby Theater",
        "url": "https://app.emby.media",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "category": "Video",
    "shortDescription": "Emby Theater web client",
    "longDescription": "A native WebKitGTK webview wrapper for the Emby web client at https://app.emby.media.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./EmbyTheater.desktop"
      }
    }
  }
}
