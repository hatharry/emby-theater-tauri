{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Emby window (remote URL)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-discover-servers",
    "allow-wake-on-lan",
    "allow-quit-app"
  ],
  "remote": {
    "urls": ["http://tv.emby.media/*"]
  }
}
