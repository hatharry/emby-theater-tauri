# Clean-room amd64 build for the Emby Theater Tauri app: produces the .deb
# (Ubuntu/Debian), the .rpm (Fedora/RHEL/openSUSE) and the .AppImage
# (distro-agnostic, self-contained) for x86_64.
#
# Tauri's RPM bundler is pure Rust (rpm-rs), so a single Debian-family image
# emits a valid .rpm alongside the .deb — no rpmbuild or RPM distro needed. The
# webkit2gtk/gtk runtime Requires are injected automatically by tauri-cli;
# the media/CEC deps come from bundle>linux>{deb,rpm}>depends in tauri.conf.json.
#
# Usage:
#   docker build -f docker/Dockerfile.amd64 -t embytheater-amd64 .
#   docker run --rm embytheater-amd64            # smoke test (installs the deb)
#   docker run --rm -v "$PWD/out:/out" embytheater-amd64 bash -c \
#       'cp /app/src/target/release/bundle/{deb/*.deb,rpm/*.rpm,appimage/*.AppImage} /out/'
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Toolchain + Tauri system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg build-essential pkg-config \
    libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev \
    nodejs npm \
    desktop-file-utils rpm2cpio cpio xvfb squashfs-tools patchelf file \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# Rust via rustup (native x86_64 toolchain)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY . .

# Build the release .deb, .rpm and .AppImage bundles (host arch is amd64
# here). The AppImage is packaged by linuxdeploy, which the bundler downloads
# on first use (needs network at build time) and runs with
# APPIMAGE_EXTRACT_AND_RUN=1 — hence squashfs-tools above. bundleMediaFramework
# in tauri.conf.json pulls this image's GStreamer plugins into the AppImage so
# playback works on hosts without gstreamer installed.
RUN npm install && npm run build:native -- --bundles deb,rpm,appimage

# Verify the .deb by installing it, and the .rpm by extracting its payload
# (rpm2cpio) — an RPM distro isn't needed just to check the file list.
RUN apt-get update && apt-get install -y ./src/target/release/bundle/deb/*_amd64.deb \
    && rm -rf /var/lib/apt/lists/* \
    && test -x /usr/bin/emby-theater \
    && test -f /usr/share/applications/emby-theater.desktop \
    && desktop-file-validate /usr/share/applications/*.desktop \
    && mkdir -p /tmp/rpmx && cd /tmp/rpmx \
    && rpm2cpio /app/src/target/release/bundle/rpm/*.rpm | cpio -idm \
    && test -x ./usr/bin/emby-theater \
    && test -f ./usr/share/applications/emby-theater.desktop

# Smoke test: launch under Xvfb (no real display), give it time to start,
# then confirm the process is alive and clean up.
CMD ["bash", "-c", "xvfb-run -a /usr/bin/emby-theater & APP=$!; sleep 20; if kill -0 $APP; then echo SMOKE-TEST-PASS: emby-theater running; kill $APP; else echo SMOKE-TEST-FAIL: emby-theater exited; exit 1; fi"]
