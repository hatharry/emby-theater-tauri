# Clean-room build + smoke test for the Emby Theater Tauri app.
# Usage: docker build -f docker/Dockerfile.test -t embytheater-test . && docker run --rm embytheater-test
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Toolchain + Tauri system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg build-essential pkg-config \
    libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev \
    nodejs npm \
    desktop-file-utils xvfb \
    && rm -rf /var/lib/apt/lists/*

# Rust via rustup (matches dev setup)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY . .

# Build the release .deb bundle (native leg only; host arch is amd64 here)
RUN npm install && npm run build:native

# Install the package and verify contents
RUN apt-get update && apt-get install -y ./src/target/release/bundle/deb/*_amd64.deb \
    && rm -rf /var/lib/apt/lists/* \
    && test -x /usr/bin/emby-theater \
    && test -f /usr/share/applications/emby-theater.desktop \
    && desktop-file-validate /usr/share/applications/*.desktop

# Smoke test: launch under Xvfb (no real display), give it time to start,
# then confirm the process is alive and clean up.
CMD ["bash", "-c", "xvfb-run -a /usr/bin/emby-theater & APP=$!; sleep 20; if kill -0 $APP; then echo SMOKE-TEST-PASS: emby-theater running; kill $APP; else echo SMOKE-TEST-FAIL: emby-theater exited; exit 1; fi"]
