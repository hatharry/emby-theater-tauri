{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emby-theater",
  "version": "4.0.1",
  "identifier": "tv.emby.theater.tauri",
  "mainBinaryName": "emby-theater",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "category": "Video",
    "shortDescription": "Emby Theater web client",
    "longDescription": "A native WebKitGTK webview wrapper for the Emby Theater TV client at https://tv.emby.media.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "./emby-theater.desktop",
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-vaapi",
          "cec-utils"
        ]
      },
      "rpm": {
        "desktopTemplate": "./emby-theater.desktop",
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-libav",
          "libcec"
        ]
      }
    }
  }
}
